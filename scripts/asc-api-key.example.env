# App Store Connect API キーの設定の見本。
# このファイルをコピーして「scripts/asc-api-key.env」という名前で保存し、3つの値を書きかえる。
# (scripts/asc-api-key.env と .p8 ファイルは .gitignore に入っているので、GitHub には送られない)

# キー ID(英数字10文字)
ASC_KEY_ID=ABCDE12345
# Issuer ID(ハイフンの入った長い文字)
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ダウンロードした .p8 ファイルの場所
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_ABCDE12345.p8
