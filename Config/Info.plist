<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Secrets.xcconfig の値を、アプリの中から読めるようにする -->
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>SupabaseKey</key>
	<string>$(SUPABASE_KEY)</string>
	<!-- 「特別な暗号は使っていません」という申告。TestFlight に上げるたびに質問されるのを省く -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
