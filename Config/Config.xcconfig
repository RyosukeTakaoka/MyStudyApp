// =====================================================================
// Config.xcconfig … アプリ全体のビルド設定(Git に入れてよいファイル)
//
// ここには秘密の値を書きません。Supabase の接続先とキーは、
// となりの Secrets.xcconfig(Git に入らないファイル)に書きます。
// =====================================================================

// ---- アプリの識別名とバージョン(アプリとウィジェットで共通)----
// Bundle Identifier を変えるときは、ここだけを書きかえる(ウィジェットと App Group も自動で合わせて変わる)
APP_BUNDLE_ID = com.ryosuketakaoka.MyStudyApp
// アプリとウィジェットが共有するフォルダ(App Group)の名前
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
// バージョン。TestFlight にアップロードするたびに CURRENT_PROJECT_VERSION を 1 ずつ増やす
MARKETING_VERSION = 1.1
CURRENT_PROJECT_VERSION = 2

// ---- スクリーンタイム(集中モード)----
// Xcode から ▶ で入れる版(Debug)では、いつも使えます。
// TestFlight の版(Release)で使うには、Apple の「Family Controls (Distribution)」の許可が必要です。
// 許可が下りたら、下の行を「RELEASE_SCREEN_TIME_SUFFIX = -ScreenTime」に書きかえてください。
RELEASE_SCREEN_TIME_SUFFIX =

// まず「空」を入れておく。Secrets.xcconfig がまだ無くてもビルドが通るようにするため。
SUPABASE_HOST =
SUPABASE_KEY =

// Secrets.xcconfig があれば読み込んで、上の空の値を上書きする。
// 「#include?」の「?」は「ファイルが無くてもエラーにしない」という意味。
#include? "Secrets.xcconfig"
